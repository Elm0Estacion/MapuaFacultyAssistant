# GEMINI_API_KEY: Required for Gemini AI API calls (Cloud).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_PROVIDER: "ollama" for local offline models, or "gemini" for cloud.
# Defaults to "gemini" if GEMINI_API_KEY is present, else "ollama".
AI_PROVIDER="ollama"

# OLLAMA_HOST: URL of your local Ollama instance (default: http://127.0.0.1:11434)
OLLAMA_HOST="http://127.0.0.1:11434"

# OLLAMA_MODEL: Model name downloaded via 'ollama pull <model>' (e.g., llama3.2, mistral, gemma2)
OLLAMA_MODEL="llama3.2"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
